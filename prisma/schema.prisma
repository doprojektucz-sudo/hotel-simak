generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  phone     String?
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MenuItem {
  id           String   @id @default(cuid())
  name         String
  description  String?
  price        Int
  category     String
  weight       String?
  allergens    String?
  note         String?
  isVegetarian Boolean  @default(false)
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
}

model Drink {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Int
  category    String
  size        String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

model MenuCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DrinkCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DailyMenuDish {
  id        String            @id @default(cuid())
  name      String
  weight    String?
  price     Int
  type      String            @default("MAIN")
  isActive  Boolean           @default(true)
  sortOrder Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  menuItems DailyMenuToItem[]

  @@index([type])
  @@index([sortOrder])
}

model DailyMenu {
  id        String            @id @default(cuid())
  title     String?
  validFrom DateTime
  validTo   DateTime
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  items     DailyMenuToItem[]

  @@index([validFrom, validTo])
  @@index([isActive])
}

model DailyMenuToItem {
  id        String        @id @default(cuid())
  menuId    String
  dishId    String
  sortOrder Int           @default(0)
  dish      DailyMenuDish @relation(fields: [dishId], references: [id], onDelete: Cascade)
  menu      DailyMenu     @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@unique([menuId, dishId])
  @@index([menuId])
}

model OpeningHours {
  id        String   @id @default(cuid())
  dayOfWeek Int      @unique
  dayName   String
  isOpen    Boolean  @default(true)
  openTime  String?
  closeTime String?
  note      String?
  sortOrder Int      @default(0)
  updatedAt DateTime @updatedAt

  @@index([dayOfWeek])
}

// ============ BROŽURY ============

model Brozura {
  id        String           @id @default(cuid())
  nazev     String
  sablona   SablonaTyp       @default(AKCE)
  kategorie KategorieBrozury @default(OSTATNI)
  stav      StavBrozury      @default(ROZPRACOVANA)

  // Obsah
  nadpis    String
  podnadpis String?
  popis     String?
  datum     String?
  cas       String?
  misto     String?
  cena      String?
  kontakt   String?
  web       String?
  fotoUrl   String?
  logoUrl   String?
  mapUrl    String?

  // Vzhled
  format       FormatTisku    @default(A4)
  orientace    OrientaceTisku @default(PORTRAIT)
  layout       LayoutTyp      @default(KLASICKY)
  tema         TemaTyp        @default(TMAVE)
  barvaPozadi  String         @default("#1c1008")
  barvaText    String         @default("#fdf6e3")
  barvaAkcentu String         @default("#c9a547")

  // Brand prvky
  zobrazitLogo    Boolean @default(true)
  zobrazitPaticku Boolean @default(true)

  tagy      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kategorie])
  @@index([stav])
  @@index([sablona])
}

enum SablonaTyp {
  AKCE
  ZVERINOVE_HODY
  UBYTOVANI
  RESTAURACE
  VSEOBECNE
}

enum KategorieBrozury {
  AKCE
  MENU
  UBYTOVANI
  SPORTOVNI
  OSTATNI
}

enum StavBrozury {
  ROZPRACOVANA
  HOTOVA
  ARCHIV
}

enum FormatTisku {
  A3
  A4
  A5
}

enum OrientaceTisku {
  PORTRAIT
  LANDSCAPE
}

enum LayoutTyp {
  KLASICKY
  MAGAZIN
  MINIMA
  SIROKY
  VINTAGE
  SVETLY_CARD
  SPLIT
  MIKROMINIMA
}

enum TemaTyp {
  TMAVE
  SVETLE
  MODRE
  ZELENE
  BILA
  VLASTNI
}

model GalerieObrazek {
  id          String   @id @default(cuid())
  nazev       String                        // původní název souboru
  popis       String?                       // volitelný popis / alt text
  url         String                        // cesta: /uploads/brozury/xxx.jpg
  velikost    Int                           // bytes
  typ         String                        // image/jpeg | image/png | image/webp
  tagy        String[] @default([])         // pro filtrování: "jidlo", "budova", atd.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
}
